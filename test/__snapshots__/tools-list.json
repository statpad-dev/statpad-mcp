  {
    "name": "get_plays",
    "title": "Get plays",
    "description": "Get a game's play-by-play. mode recent returns the last plays, 10 by default; scoring returns the scoring plays, up to 50; drives returns drives or at-bats with team, result, yards, points and time of possession. Each play has the period, clock, team, description and the score after it. In NFL and NCAAF the description names the players. Every result has seq. To follow a live game, pass that seq back as after_seq to get only the plays and live-state changes since, then pass the new seq on the next call. If the stream no longer holds after_seq, the result has resync_required and a fresh seq from a new game read.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "league": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$",
          "description": "League alias, such as nfl, ncaaf or epl. list_leagues returns the leagues this key can read."
        },
        "game_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
          "description": "Game id, from find_games."
        },
        "mode": {
          "default": "recent",
          "description": "recent: the last plays. scoring: scoring plays only. drives: drives or at-bats with their result.",
          "type": "string",
          "enum": [
            "recent",
            "scoring",
            "drives"
          ]
        },
        "limit": {
          "description": "How many plays or drives to return, newest last. Default 10 recent plays, up to 50 scoring plays, and every drive.",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "after_seq": {
          "description": "Only what changed after this seq, from an earlier result. Works with recent and scoring.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "league",
        "game_id"
      ]
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "league": {
          "type": "string"
        },
