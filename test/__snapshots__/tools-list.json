        "player": {
          "description": "Only players whose name contains this, such as \"allen\".",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "description": "Only this stat category, such as passing, rushing, receiving, defensive, interceptions, fumbles, kicking, punting, kick_returns, punt_returns, soccer.",
          "type": "string",
          "pattern": "^[a-z_]+$"
        }
